generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Remaining models land here per Module 1 (specs/01-database.md).

enum MessageStatus {
  new
  read
  archived
}

/// Contact form submissions (specs/06-contact.md). Shape mirrors `contactSchema` in /shared.
model Message {
  id        String        @id @default(cuid())
  name      String        @db.VarChar(60)
  email     String        @db.VarChar(254)
  subject   String?       @db.VarChar(120)
  body      String        @db.VarChar(2000)
  /// HMAC-SHA256 of the sender IP with IP_HASH_SALT — never the raw IP.
  ipHash    String        @db.Char(64)
  userAgent String?       @db.VarChar(500)
  status    MessageStatus @default(new)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt(sort: Desc)])
}

/// One row per public page view (specs: admin analytics). No cookies, no raw IPs.
model PageView {
  id           String   @id @default(cuid())
  path         String   @db.VarChar(200)
  /// Host of an external referrer only (e.g. "linkedin.com"); null for direct / internal.
  referrerHost String?  @db.VarChar(100)
  /// HMAC-SHA256(IP_HASH_SALT, ip + user agent) — counts unique visitors, can't be reversed.
  visitorHash  String   @db.Char(64)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

enum BlogStatus {
  draft
  published
}

/// Long-form project documentation. `projectSlug` maps to the portfolio's project catalogue.
model ProjectBlog {
  id          String     @id @default(cuid())
  projectSlug String     @db.VarChar(80)
  title       String     @db.VarChar(160)
  slug        String     @unique @db.VarChar(180)
  excerpt     String     @db.VarChar(320)
  status      BlogStatus @default(draft)
  chapters    Json
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  publishedAt DateTime?
  feedback    BlogFeedback[]

  @@index([projectSlug, status, publishedAt(sort: Desc)])
}

/// Suggestions from readers; they are never public and only admins can manage them.
model BlogFeedback {
  id        String      @id @default(cuid())
  blogId    String
  name      String      @db.VarChar(60)
  email     String?     @db.VarChar(254)
  message   String      @db.VarChar(1200)
  createdAt DateTime    @default(now())
  blog      ProjectBlog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([blogId, createdAt(sort: Desc)])
}
